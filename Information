<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>主链路 + 闭环回流流程图｜Clean Tactical Projection UI</title>
  <style>
    :root { --orange: rgb(255,127,0); --white: rgb(244,255,255); --bg: #030507; --text: rgba(244,255,255,.90); }
    * { box-sizing: border-box; }
    html, body { margin:0; width:100%; height:100%; overflow:hidden; background:#071015; color:var(--text); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif; }
    body::before, body::after { content:""; position:fixed; inset:0; pointer-events:none; }
    body::before { z-index:0; background: radial-gradient(ellipse at 52% 50%, rgba(255,127,0,.10), transparent 32%), radial-gradient(ellipse at 70% 30%, rgba(244,255,255,.055), transparent 22%), linear-gradient(135deg,#020304 0%,#071015 52%,#030507 100%); }
    body::after { z-index:1; opacity:.34; background-image: linear-gradient(rgba(244,255,255,.022) 1px, transparent 1px), linear-gradient(90deg,rgba(244,255,255,.022) 1px,transparent 1px), linear-gradient(rgba(255,127,0,.018) 1px,transparent 1px), linear-gradient(90deg,rgba(255,127,0,.018) 1px,transparent 1px); background-size:96px 96px,96px 96px,18px 18px,18px 18px; mask-image:radial-gradient(circle at center,black 0,black 64%,transparent 98%); }
    .page { position:relative; z-index:2; width:100vw; height:100vh; min-height:420px; padding:0; }
    .stage { position:relative; width:100%; height:100%; overflow:hidden; border:0; background: linear-gradient(180deg,rgba(244,255,255,.018),rgba(244,255,255,.004)), radial-gradient(ellipse at 51% 50%,rgba(255,127,0,.026),transparent 46%); box-shadow: inset 0 0 0 1px rgba(255,255,255,.012), inset 0 0 130px rgba(255,127,0,.012), 0 26px 80px rgba(0,0,0,.52); }
    .stage::before { content:""; position:absolute; inset:0; z-index:3; pointer-events:none; opacity:.08; background:repeating-linear-gradient(0deg,rgba(244,255,255,.032) 0,rgba(244,255,255,.032) 1px,transparent 1px,transparent 8px); }
    .top-ui { position:absolute; left:26px; top:22px; z-index:6; pointer-events:none; }
    .top-row { display:flex; align-items:center; gap:9px; margin-bottom:14px; }
    .glyph { width:34px; height:34px; display:grid; place-items:center; border:1px solid rgba(244,255,255,.10); background:rgba(5,8,10,.55); color:rgba(244,255,255,.62); font-size:15px; backdrop-filter:blur(8px); }
    .glyph.active { background:var(--orange); border-color:var(--orange); color:#121416; }
    .home-title { margin-left:8px; display:flex; align-items:center; gap:12px; color:rgba(244,255,255,.90); font-size:24px; font-weight:300; letter-spacing:.14em; }
    .home-title::before, .home-title::after { content:""; width:1px; height:26px; background:rgba(244,255,255,.20); }
    .title-line { display:flex; align-items:center; gap:14px; }
    .section-code { height:38px; padding:0 14px; display:grid; place-items:center; color:#fff; background:var(--orange); font-size:21px; font-weight:300; letter-spacing:.08em; }
    .section-name { color:rgba(242,196,67,.95); font-size:27px; font-weight:300; letter-spacing:.07em; }
    .section-sub { margin-top:8px; margin-left:4px; color:rgba(244,255,255,.38); font-size:10px; letter-spacing:.18em; text-transform:uppercase; }
    .workflow-wrap { position:absolute; inset:0; z-index:4; }
    svg { width:100%; height:100%; display:block; }
    .bg-topo { opacity:.18; }
    .bg-structure { fill:none; stroke:rgba(244,255,255,.048); stroke-width:1; }
    .bg-structure.orange { stroke:rgba(255,127,0,.055); }
    .flow-line { fill:none; stroke:rgba(244,255,255,.38); stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
    .flow-line.main { stroke:rgba(255,127,0,.70); stroke-width:1.65; stroke-dasharray:8 15; animation:routeFlow 2.2s linear infinite; filter:url(#softGlow); }
    .flow-line.return { stroke:rgba(244,255,255,.35); stroke-width:1.35; stroke-dasharray:4 10; }
    .flow-line.feedback { stroke:rgba(255,127,0,.62); stroke-width:1.5; stroke-dasharray:6 13; animation:routeFlow 2.8s linear infinite; filter:url(#softGlow); }
    @keyframes routeFlow { from{stroke-dashoffset:76;} to{stroke-dashoffset:0;} }
    .node-panel { fill:rgba(9,13,17,.23); stroke:rgba(244,255,255,.22); stroke-width:.75; filter:url(#panelShadow); }
    .node-panel.primary { fill:rgba(13,18,22,.30); stroke:rgba(255,127,0,.44); filter:url(#selectedGlow); }
    .node-panel.focus { fill:rgba(13,18,22,.36); stroke:rgba(255,127,0,.62); filter:url(#selectedGlow); }
    .node-corner { fill:none; stroke:rgba(255,127,0,.58); stroke-width:1.35; opacity:0; filter:url(#softGlow); }
    .node.primary .node-corner, .node.focus .node-corner { opacity:.90; }
    .node-text { fill:rgba(244,255,255,.78); font-size:18px; font-weight:650; letter-spacing:.04em; text-anchor:middle; dominant-baseline:central; }
    .node-sub { fill:rgba(244,255,255,.38); font-size:10px; letter-spacing:.12em; text-anchor:middle; dominant-baseline:central; text-transform:uppercase; }
    .node.primary .node-text, .node.focus .node-text { fill:rgba(244,255,255,.98); paint-order:stroke; stroke:rgba(0,0,0,.45); stroke-width:3px; stroke-linejoin:round; }
    .node.primary .node-sub, .node.focus .node-sub { fill:rgba(255,205,140,.88); }
    .anchor { fill:var(--orange); filter:url(#softGlow); }
    .anchor.white { fill:var(--white); filter:none; }
    .anchor-frame, .anchor-tick { fill:none; stroke:rgba(244,255,255,.58); stroke-width:1; vector-effect:non-scaling-stroke; }
    .anchor-frame { opacity:.50; } .anchor-tick { opacity:.75; }
    .lane-label { fill:rgba(255,127,0,.54); font-size:12px; letter-spacing:.12em; text-anchor:middle; dominant-baseline:central; text-transform:uppercase; }
    .lane-label.white { fill:rgba(244,255,255,.34); }
    .side-bracket { fill:none; stroke:rgba(244,255,255,.72); stroke-width:2; stroke-linecap:round; opacity:.78; }
    .caption { position:absolute; left:28px; bottom:20px; z-index:6; color:rgba(244,255,255,.36); font-size:10px; letter-spacing:.14em; text-transform:uppercase; pointer-events:none; }
    .caption strong { color:rgba(255,127,0,.78); font-weight:650; }
    @media (max-width:980px) { .workflow-wrap { inset:0; } .section-name{font-size:22px;} .node-text{font-size:15px;} .node-sub{font-size:9px;} }
    @media (max-width:720px) { .page{padding:8px;} .stage{border-width:0;} .top-ui{transform:scale(.82); transform-origin:left top;} .workflow-wrap { inset:0; } .caption{display:none;} }
  </style>
</head>
<body>
  <div class="page">
    <main class="stage">
<section class="workflow-wrap">
        <svg id="workflow" viewBox="0 70 1600 520" preserveAspectRatio="xMidYMid meet" role="img" aria-label="主链路加闭环回流流程图">
          <defs>
            <marker id="arrowWhite" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="rgba(244,255,255,.76)" /></marker>
            <marker id="arrowOrange" viewBox="0 0 10 10" refX="8.2" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 Z" fill="rgba(255,127,0,.88)" /></marker>
            <filter id="softGlow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="2.2" result="blur"/><feColorMatrix in="blur" type="matrix" values="1 0 0 0 0.96  0 0.56 0 0 0.28  0 0 0.12 0 0.02  0 0 0 0.72 0" result="orangeBlur"/><feMerge><feMergeNode in="orangeBlur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <filter id="selectedGlow" x="-80%" y="-80%" width="260%" height="260%"><feDropShadow dx="0" dy="0" stdDeviation="2.2" flood-color="rgba(255,127,0,.34)"/><feDropShadow dx="0" dy="0" stdDeviation="5.5" flood-color="rgba(255,127,0,.12)"/></filter>
            <filter id="panelShadow" x="-60%" y="-60%" width="220%" height="220%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="rgba(0,0,0,.48)"/></filter>
            <pattern id="topo" width="360" height="240" patternUnits="userSpaceOnUse"><path d="M-30,130 C40,44 120,175 200,78 C246,20 310,88 365,30 M-40,170 C60,68 128,196 224,105 C270,62 320,100 380,56 M-10,78 C54,12 104,98 150,48 C188,16 242,30 276,8" fill="none" stroke="rgba(244,255,255,.046)" stroke-width="1"/><path d="M-18,120 C46,40 110,150 184,76 C228,25 282,84 336,28 M-30,150 C60,68 130,188 220,102 C260,70 312,98 360,58" fill="none" stroke="rgba(255,127,0,.040)" stroke-width="1"/></pattern>
          </defs>
          <rect class="bg-topo" x="0" y="0" width="1600" height="620" fill="url(#topo)" />
          <path class="bg-structure" d="M60,395 C260,338 420,355 615,286 S980,205 1260,250 S1460,315 1570,260" />
          <path class="bg-structure" d="M160,118 C395,126 535,105 725,138 S1110,126 1510,92" />
          <path class="bg-structure orange" d="M190,505 C405,460 560,500 760,450 S1120,415 1380,450" />
          <path class="bg-structure" d="M468,42 L760,512 M940,52 L1150,540 M1190,112 L1500,422" />
          <text class="lane-label" x="800" y="116">PRIMARY PRODUCTION CHAIN</text>
          <text class="lane-label white" x="800" y="454">REVIEW · DELIVERY · FEEDBACK LOOP</text>
          <path class="side-bracket" d="M24,178 C18,178 17,184 17,193 L17,274 C17,283 18,289 24,289" />
          <path class="side-bracket" d="M1576,178 C1582,178 1583,184 1583,193 L1583,274 C1583,283 1582,289 1576,289" />
          <path class="flow-line main" marker-end="url(#arrowOrange)" d="M286,220 L376,220" />
          <path class="flow-line main" marker-end="url(#arrowOrange)" d="M526,220 L616,220" />
          <path class="flow-line main" marker-end="url(#arrowOrange)" d="M766,220 L856,220" />
          <path class="flow-line main" marker-end="url(#arrowOrange)" d="M1006,220 L1096,220" />
          <path class="flow-line feedback" marker-end="url(#arrowOrange)" d="M1250,254 C1268,312 1248,355 1170,384" />
          <path class="flow-line" marker-end="url(#arrowWhite)" d="M1034,408 L914,408" />
          <path class="flow-line" marker-end="url(#arrowWhite)" d="M778,408 L658,408" />
          <path class="flow-line return" marker-end="url(#arrowWhite)" d="M518,392 C332,352 236,298 208,255" />
          <path class="flow-line feedback" marker-end="url(#arrowOrange)" d="M584,384 C520,324 500,288 480,254" />
          <g transform="translate(208,220)"><rect class="anchor" x="-4" y="-4" width="8" height="8"/><rect class="anchor-frame" x="-12" y="-12" width="24" height="24"/><path class="anchor-tick" d="M-24,0 H-14 M14,0 H24 M0,-24 V-14 M0,14 V24"/></g>
          <g transform="translate(1248,220)"><rect class="anchor white" x="-4" y="-4" width="8" height="8"/><rect class="anchor-frame" x="-12" y="-12" width="24" height="24"/><path class="anchor-tick" d="M-24,0 H-14 M14,0 H24 M0,-24 V-14 M0,14 V24"/></g>
          <g transform="translate(584,408)"><rect class="anchor" x="-4" y="-4" width="8" height="8"/><rect class="anchor-frame" x="-12" y="-12" width="24" height="24"/><path class="anchor-tick" d="M-24,0 H-14 M14,0 H24 M0,-24 V-14 M0,14 V24"/></g>
          <g class="node focus" transform="translate(208,220)"><path class="node-corner" d="M-76,-34 H-42 M76,-34 H42 M-76,34 H-42 M76,34 H42"/><rect class="node-panel focus" x="-78" y="-34" width="156" height="68"/><text class="node-text" x="0" y="-4">① 数据采集</text><text class="node-sub" x="0" y="19">FIELD DATA INPUT</text></g>
          <g class="node focus" transform="translate(448,220)"><path class="node-corner" d="M-82,-34 H-44 M82,-34 H44 M-82,34 H-44 M82,34 H44"/><rect class="node-panel focus" x="-84" y="-34" width="168" height="68"/><text class="node-text" x="0" y="-4">② 数据标准化</text><text class="node-sub" x="0" y="19">STANDARDIZE</text></g>
          <g class="node" transform="translate(688,220)"><rect class="node-panel" x="-78" y="-32" width="156" height="64"/><text class="node-text" x="0" y="-4">③ 图文绘制</text><text class="node-sub" x="0" y="18">DRAWING</text></g>
          <g class="node" transform="translate(928,220)"><rect class="node-panel" x="-78" y="-32" width="156" height="64"/><text class="node-text" x="0" y="-4">④ 三维建模</text><text class="node-sub" x="0" y="18">3D MODEL</text></g>
          <g class="node primary" transform="translate(1248,220)"><path class="node-corner" d="M-84,-40 H-46 M84,-40 H46 M-84,40 H-46 M84,40 H46"/><rect class="node-panel primary" x="-86" y="-40" width="172" height="80"/><text class="node-text" x="0" y="-4">⑤ 平台集成</text><text class="node-sub" x="0" y="21">PLATFORM INTEGRATION</text></g>
          <g class="node primary" transform="translate(1118,408)"><path class="node-corner" d="M-78,-36 H-42 M78,-36 H42 M-78,36 H-42 M78,36 H42"/><rect class="node-panel primary" x="-80" y="-36" width="160" height="72"/><text class="node-text" x="0" y="-4">⑥ 成果审查</text><text class="node-sub" x="0" y="20">QUALITY REVIEW</text></g>
          <g class="node" transform="translate(846,408)"><rect class="node-panel" x="-78" y="-32" width="156" height="64"/><text class="node-text" x="0" y="-4">⑦ 资料汇交</text><text class="node-sub" x="0" y="18">DELIVERY</text></g>
          <g class="node primary" transform="translate(584,408)"><path class="node-corner" d="M-78,-36 H-42 M78,-36 H42 M-78,36 H-42 M78,36 H42"/><rect class="node-panel primary" x="-80" y="-36" width="160" height="72"/><text class="node-text" x="0" y="-4">⑧ 反馈优化</text><text class="node-sub" x="0" y="20">FEEDBACK OPTIMIZE</text></g>
          <text class="lane-label white" x="312" y="340">反馈回流至数据采集 / 标准化</text>
          <text class="lane-label" x="1295" y="330">平台输出进入成果审查</text>
        </svg>
      </section>
</main>
  </div>
</body>
</html>
